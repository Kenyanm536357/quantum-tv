{
  "name": "IPTVConfig",
  "type": "object",
  "properties": {
    "base_url": {
      "type": "string",
      "description": "Xtream Codes API base URL"
    },
    "username": {
      "type": "string",
      "description": "Xtream Codes username"
    },
    "password": {
      "type": "string",
      "description": "Xtream Codes password"
    },
    "label": {
      "type": "string",
      "description": "Friendly label for this configuration"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "error",
        "pending"
      ],
      "default": "pending",
      "description": "Connection status after last sync"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the last sync attempt"
    },
    "error_message": {
      "type": "string",
      "description": "Error message from last failed sync"
    }
  },
  "required": [
    "base_url",
    "username",
    "password"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}