        "backgroundColor": "#060714"
      },
      "package": "com.quantumtv.app"
    },
    "plugins": [
      "expo-router",
      "expo-video"
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "backendUrl": "https://740c242f-4923-4028-ac71-f7cfb28f51cc.preview.emergentagent.com"
    }
  }
