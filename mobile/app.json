{
  "expo": {
    "name": "Quantum TV",
    "slug": "quantum-tv",
    "version": "1.0.14",
    "orientation": "landscape",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "scheme": "quantumtv",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#060714"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quantumtv.app"
    },
    "android": {
      "package": "com.quantumtv.app",
      "versionCode": 51,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#060714"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK",
        "QUERY_ALL_PACKAGES"
      ],
      "intentFilters": [
        {
          "action": "MAIN",
          "category": [
            "LAUNCHER",
            "LEANBACK_LAUNCHER"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 23
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "dcff3612-a952-43e9-a210-ddefaffcd9e8"
      },
      "backendUrl": "https://quantum-tv-production.up.railway.app"
    },
    "owner": "kenyanm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dcff3612-a952-43e9-a210-ddefaffcd9e8",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
