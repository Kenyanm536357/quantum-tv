{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://quantum-tv-production.up.railway.app"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://quantum-tv-production.up.railway.app"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": false
      }
    },
    "appstore": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://quantum-tv-production.up.railway.app"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
